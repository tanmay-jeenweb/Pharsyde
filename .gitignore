# ==============================================================================
# Pharsyde Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/

# Production & Build outputs
dist/
dist-ssr/
build/
Frontend/dist/

# Environment Variables & Secrets
.env
.env.*
.env.local
.env.*.local
!.env.example
!*/.env.example

# User Uploaded Files (IDs, Documents, Customer Files)
Backend/uploads/*
!Backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# Archives and Compressed Files (Prevent uploading deployment zips)
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.gz

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime / Cache
.cache/
.vite/
tmp/
temp/

# Editor and IDE Files
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

