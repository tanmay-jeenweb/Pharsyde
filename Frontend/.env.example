# Frontend Development Server Port
VITE_PORT=5173

# Backend Server URL for Vite dev proxy
VITE_BACKEND_URL=http://localhost:5000

# API Base URL (Optional)
# Leave empty to use '/api' relative URL with Vite proxy / reverse proxy (Recommended)
# Or specify full URL (e.g. http://localhost:5000 or https://api.yourdomain.com)
VITE_API_URL=

